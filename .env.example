# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI Configuration
OPENAI_API_KEY=your_openai_api_key

# OCR Configuration (optional - uses stub if not provided)
OCR_API_KEY=your_ocr_api_key
OCR_API_URL=https://api.ocr.space/parse/image

# External API Integrations (optional - enhanced pricing and reputation data)
# VehicleDatabases.com API - for verified market pricing (Recommended - $100-200/month)
VEHICLE_DATABASES_API_KEY=your_vehicledatabases_api_key
VEHICLE_DATABASES_API_URL=https://api.vehicledatabases.com/v1

# RepairPal API - alternative pricing source (currently placeholder - API not publicly available)
REPAIRPAL_API_KEY=your_repairpal_api_key

# BLS API - for labor rate data (FREE - no key required)
BLS_API_URL=https://api.bls.gov/publicAPI/v2

# Google Places API - for shop reputation verification
GOOGLE_PLACES_API_KEY=your_google_places_api_key

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
