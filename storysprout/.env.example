# StorySprout Environment Variables
# Copy this file to .env.local and fill in your values

# ===========================================
# SUPABASE CONFIGURATION
# ===========================================
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# ===========================================
# ANTHROPIC AI (Claude) - Story Generation
# ===========================================
ANTHROPIC_API_KEY=your_anthropic_api_key

# ===========================================
# N8N WORKFLOW INTEGRATION (Optional)
# ===========================================
N8N_WEBHOOK_URL=your_n8n_webhook_url
N8N_API_KEY=your_n8n_api_key

# ===========================================
# TEXT-TO-SPEECH (Optional)
# ===========================================
# Choose one TTS provider:
# Option 1: ElevenLabs
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# Option 2: Google Cloud TTS
GOOGLE_CLOUD_TTS_KEY=your_google_tts_key

# Option 3: Azure Speech Services
AZURE_SPEECH_KEY=your_azure_speech_key
AZURE_SPEECH_REGION=your_azure_region

# ===========================================
# CONTENT MODERATION (Optional)
# ===========================================
# Additional content safety layer
PERSPECTIVE_API_KEY=your_perspective_api_key

# ===========================================
# ANALYTICS (Optional)
# ===========================================
NEXT_PUBLIC_POSTHOG_KEY=your_posthog_key
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# ===========================================
# APPLICATION SETTINGS
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=StorySprout

# Story Generation Settings
MAX_STORY_LENGTH=2000
DEFAULT_READING_LEVEL=grade_1
ENABLE_AI_ILLUSTRATIONS=false

# Rate Limiting
RATE_LIMIT_STORIES_PER_HOUR=10
RATE_LIMIT_AUDIO_PER_HOUR=20
